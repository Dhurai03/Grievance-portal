{
  "name": "college-grievance-portal",
  "version": "2.0.0",
  "description": "EduGrieve - AI-Enabled College Grievance Portal with NLP Routing & MongoDB",
  "private": true,
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "client": "npm --prefix frontend run dev",
    "server": "npm --prefix backend run start",
    "backend": "npm --prefix backend run start",
    "seed": "npm --prefix backend run seed",
